# ---- Database ----
DB_NAME=toeic_ai_learning
DB_URL=jdbc:postgresql://postgres:5432/toeic_ai_learning
DB_USERNAME=postgres
DB_PASSWORD=replace-with-a-strong-password

# Docker host port bindings. For production behind a reverse proxy, bind to loopback.
POSTGRES_PORT_BIND=127.0.0.1:5433:5432
BACKEND_PORT_BIND=127.0.0.1:8080:8080
FRONTEND_PORT_BIND=127.0.0.1:3000:3000
# On VPS, set this to an absolute persistent directory such as /opt/toeic-media.
# Locally, use the existing frontend/public media folders.
MEDIA_DIR=./frontend/public

# ---- JWT ----
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION=3600000

# ---- Gemini API ----
GEMINI_API_KEY=changeme

# ---- Password reset email (SMTP) ----
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_FROM=no-reply@example.com
PASSWORD_RESET_TOKEN_TTL=PT2M
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
FRONTEND_URL=http://localhost:3000
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_SECURE=false

# ---- Google OAuth (optional; enables Google buttons on login and signup) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- VietQR receiving account and SePay webhook (required to enable student checkout) ----
# Use a bank BIN/code accepted by VietQR and the account receiving the transfers.
VIETQR_BANK_CODE=
VIETQR_ACCOUNT_NUMBER=
VIETQR_ACCOUNT_NAME=
# Configure the same token in SePay's webhook Authorization header: Apikey <token>.
SEPAY_WEBHOOK_TOKEN=

# ---- Frontend API ----
NEXT_PUBLIC_API_URL=http://localhost:8080
